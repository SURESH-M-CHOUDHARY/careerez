# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#self declared files to ignore
# Node modules
node_modules/

# Yarn cache
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarnrc.yml

# Next.js
.next/
out/
.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.log

# OS Files
.DS_Store
Thumbs.db

# Env Files (API keys, secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Prisma
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/*/README.md

# VSCode
.vscode/

# Mac system files
*.swp
*.swo
.idea/

# Build output
dist/
build/

# Optional: test outputs or coverage
coverage/
jest-coverage/

# Clerk (no special ignore needed unless local .clerk/ exists)
.clerk/

# Optional: Log uploads or public user uploads (if any)
public/uploads
